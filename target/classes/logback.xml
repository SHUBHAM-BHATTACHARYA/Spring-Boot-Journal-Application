<Configuration>
    <!-- Console Appender -->
    <appender name="SpringConsoleAppender" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{dd-MM-yyyy HH:mm:ss.SSS} [%thread] %highlight(%-5level) [%blue(%t)] %yellow(%logger{45}) : %msg%n%throwable
            </pattern>
        </encoder>
    </appender>

    <!-- Rolling File Appender -->
    <appender name="SpringFileAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>
            logs/journalApp.log
        </file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Daily rollover with compression -->
            <fileNamePattern>logs/journalApp-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>
                %d{dd-MM-yyyy HH:mm:ss.SSS} [%thread] %highlight(%-5level) [%blue(%t)] %yellow(%logger{45}) : %msg%n%throwable
            </pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="SpringConsoleAppender"/>
        <appender-ref ref="SpringFileAppender"/>
    </root>
</Configuration>